# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/DB"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-random-secret
GOOGLE_CLIENT_ID=your-value-here
GOOGLE_CLIENT_SECRET=your-value-here
GITHUB_ID=your-value-here
GITHUB_SECRET=your-value-here
# EmailJS (browser-exposed identifiers)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key
